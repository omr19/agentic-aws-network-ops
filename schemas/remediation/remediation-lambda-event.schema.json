{
  "$id": "https://agentic-aws-network-ops.example/schemas/remediation/remediation-lambda-event.schema.json",
  "title": "Remediation Lambda event",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "request", "execution_id"],
  "properties": {
    "action": { "enum": ["restore_security_group_ingress", "restore_vpc_peering_route", "restore_network_acl_entry"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scenario_id", "approval_id", "request_hash", "correlation_id", "policy_session_id"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "scenario_id": { "enum": ["security_group_rule", "route_table_entry", "nacl_rule"] },
        "approval_id": { "type": "string", "format": "uuid" },
        "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "policy_session_id": { "type": "string", "format": "uuid" }
      }
    },
    "execution_id": { "type": "string", "format": "uuid" }
  }
}
