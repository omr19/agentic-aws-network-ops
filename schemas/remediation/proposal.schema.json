{
  "$id": "https://agentic-aws-network-ops.example/schemas/remediation/proposal.schema.json",
  "title": "Human-readable remediation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "approval_id", "correlation_id", "policy_session_id", "scenario_id", "action", "region", "resource", "operation", "parameters", "required_tags", "evidence", "expected_result", "request_hash", "proposed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "proposal_id": { "type": "string", "format": "uuid" }, "approval_id": { "type": "string", "format": "uuid" }, "correlation_id": { "type": "string", "format": "uuid" }, "policy_session_id": { "type": "string", "format": "uuid" },
    "scenario_id": { "enum": ["security_group_rule", "route_table_entry", "nacl_rule", "peering_routes_dns"] },
    "action": { "enum": ["restore_security_group_ingress", "restore_vpc_peering_route", "restore_network_acl_entry"] },
    "region": { "type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-\\d$" }, "resource": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "enum": ["AuthorizeSecurityGroupIngress", "CreateRoute", "ReplaceRoute", "CreateRouteOrReplaceRoute", "ReplaceNetworkAclEntry"] },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": { "const": "tcp" },
        "from_port": { "const": 443 },
        "to_port": { "const": 443 },
        "cidr_ip": { "const": "10.10.0.0/16" },
        "cidr_block": { "const": "10.10.0.0/16" },
        "rule_number": { "const": 100 },
        "egress": { "const": false },
        "rule_action": { "const": "allow" },
        "route_targets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["route_table_ids", "destination_cidr", "vpc_peering_connection_id"], "properties": { "route_table_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "destination_cidr": { "enum": ["10.10.0.0/16", "10.20.0.0/16"] }, "vpc_peering_connection_id": { "type": "string", "minLength": 1 } } } }
      },
      "minProperties": 1
    },
    "required_tags": { "type": "object", "additionalProperties": false, "required": ["Project", "Environment", "ManagedBy"], "properties": { "Project": { "const": "agentic-aws-network-ops" }, "Environment": { "const": "lab" }, "ManagedBy": { "const": "terraform" } } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fact"], "properties": { "fact": { "type": "string", "minLength": 1 } } } },
    "expected_result": { "type": "string", "minLength": 1 }, "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "proposed_at": { "type": "string", "format": "date-time" }
  }
}
