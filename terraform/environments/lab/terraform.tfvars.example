# Copy this file to terraform.tfvars for local use. Real .tfvars files are ignored.
# Keep credentials, account IDs, secrets, and private configuration out of this file.

aws_region   = "eu-west-1"
project_name = "agentic-aws-network-ops"
environment  = "lab"

# Enable only during an explicitly controlled diagnostic or demo session.
enable_flow_logs       = false
flow_log_retention_days = 7

# Phase 8 readiness is opt-in and disabled by default; enabling it requires a separate AWS/IAM gate.
enable_phase8_readiness = false

# Explicit IAM principal ARNs authorized to submit approval decisions. Keep empty until
# a separately approved authenticated invocation path and operator identity are configured.
phase8_authorized_approvers = []

# Phase 6 controlled scenario. Keep this at "healthy" unless running a controlled
# failure/diagnosis exercise. Allowed: healthy, broken_sg, broken_route, broken_nacl,
# broken_dns, broken_peering. Injecting a scenario still requires a separately
# authorized terraform apply.
scenario = "healthy"
