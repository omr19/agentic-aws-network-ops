# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Terraform plan output files
*.tfplan
tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# ──────────────────────────────────────────
# Python
# ──────────────────────────────────────────

# Virtual environments
venv/
.venv/
env/

# Bytecode & compiled files
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging artifacts
*.egg-info/
dist/
build/
.eggs/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tflint.d/

# Test coverage
.coverage
*.coverage
coverage.xml
htmlcov/

# ──────────────────────────────────────────
# macOS
# ──────────────────────────────────────────

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ──────────────────────────────────────────
# Environment & secrets files
# ──────────────────────────────────────────

# dotenv — keep .env.example / .env.template eligible for version control
.env
.env.*
!.env.example
!.env.template

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx

# ──────────────────────────────────────────
# AWS & local credential artifacts
# ──────────────────────────────────────────

# Credential files that may be dropped locally
.aws/credentials
aws_credentials
credentials.json
