{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApprovalTableReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:${region}:${account_id}:table/${approval_table_name}",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-1" } }
    }
  ]
}
